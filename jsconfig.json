{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "tests/**/*.js", "tools/**/*.mjs"],
  "exclude": ["node_modules", "dist", "public"]
}
